{
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/cos02/schemas/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "webprobe",
          "version": "3.0.0",
          "informationUri": "https://github.com/webprobe",
          "rules": [
            {
              "id": "CWE-693",
              "name": "Missingsecurityheader",
              "shortDescription": {
                "text": "Missing security header"
              },
              "fullDescription": {
                "text": "Missing security header (A05:2021). Compliance: CWE: CWE-693, OWASP: A05:2021, PCI-DSS v4.0: 6.5.10"
              },
              "properties": {
                "tags": [
                  "security",
                  "A05:2021",
                  "CWE-693"
                ],
                "precision": "high",
                "security-severity": "3.1"
              }
            },
            {
              "id": "CWE-1004",
              "name": "Insecuresessioncookie",
              "shortDescription": {
                "text": "Insecure session cookie"
              },
              "fullDescription": {
                "text": "Insecure session cookie (A07:2021). Compliance: CWE: CWE-1004, OWASP: A07:2021, PCI-DSS v4.0: 6.5.6"
              },
              "properties": {
                "tags": [
                  "security",
                  "A07:2021",
                  "CWE-1004"
                ],
                "precision": "high",
                "security-severity": "5.0"
              }
            },
            {
              "id": "CWE-285",
              "name": "Missingauthorization",
              "shortDescription": {
                "text": "Missing authorization"
              },
              "fullDescription": {
                "text": "Missing authorization (A01:2021). Compliance: CWE: CWE-285, OWASP: A01:2021, PCI-DSS v4.0: 6.5.8"
              },
              "properties": {
                "tags": [
                  "security",
                  "A01:2021",
                  "CWE-285"
                ],
                "precision": "high",
                "security-severity": "8.1"
              }
            }
          ]
        }
      },
